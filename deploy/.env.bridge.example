# Copy to deploy/.env.bridge (git-ignored) and fill in. deploy-web.sh installs it on
# the host when the host has none yet. Read only by the wetter-bridge container.
#
# MQTT broker Home Assistant uses (Mosquitto on the same host, published on :1883).
# Recommended: a dedicated broker user for the bridge – create it yourself on the host:
#   docker exec -it mosquitto mosquitto_passwd /mosquitto/config/mosquitto.passwd wetter-bridge
#   docker kill -s HUP mosquitto        # reload the password file
# Leave MQTT_URL empty to run without MQTT (JSON endpoints /api/ha/* only).
MQTT_URL=mqtt://192.168.178.95:1883
MQTT_USERNAME=wetter-bridge
MQTT_PASSWORD=

# Optional: limit which stations become HA devices (ids from src/lib/locations.ts),
# comma-separated. Empty = all regional stations.
STATIONS=

# Optional tuning (seconds). Open-Meteo recomputes current values every 15 min.
CURRENT_INTERVAL_S=300
FORECAST_INTERVAL_S=900

# Link shown on the HA device page ("Visit") – use your public tunnel hostname once it exists.
PUBLIC_URL=http://192.168.178.95:8883
