# Copy to deploy/.env (git-ignored) and fill in. deploy-web.sh ships it to the
# host on the first deploy, or whenever the host has none yet.
#
# Token of THIS site's own Cloudflare tunnel (Zero Trust → Networks → Tunnels →
# Create tunnel → Cloudflared → copy the token from the `--token` command).
# Leave empty to run without the tunnel (site only on http://192.168.178.95:8883).
CLOUDFLARED_TUNNEL_TOKEN=
